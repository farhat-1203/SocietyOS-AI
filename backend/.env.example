# Server Configuration
NODE_ENV=development
PORT=3001
HOST=localhost
LOG_LEVEL=debug

# Database
MONGODB_URI=mongodb://localhost:27017/societyos-dev

# JWT Authentication
JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Application
NODE_PROCESS_TYPE=web
